<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      R2BOT Kids (standalone): every page is bundled in the APK and the app works
      with no network. Two permissions only: INTERNET (normal, install-time; kept so
      a grown-up's outbound link and future optional features can work, nothing in
      the app needs it) and CAMERA (Workshop "magic window" AR, asked at runtime;
      frames never leave the device). No location, contacts, microphone, storage,
      ads or analytics SDKs.

      allowBackup="false": no Google cloud backup and no adb backup of the app's data.
      Progress lives on the device (WebView localStorage) and may hold a child's robot
      name or profile nicknames, so it is not copied to a cloud account. A family moves
      progress with the in-app backup code (Garage / Settings), which they control.
    -->

    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/AppTheme">

        <!-- orientation not locked: portrait and landscape both work (games, tablets, Code Lab). -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:screenOrientation="fullUser"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Asked at runtime only when a child opens Workshop AR. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Camera is optional: the app installs on devices without one (AR just stays off). -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <!-- Belt and braces for Designed for Families: strip these even if a future
         library tries to merge them in. -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_CONTACTS" tools:node="remove" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" tools:node="remove" />
</manifest>
