ush",1.61,1.96],["in",1.96,2.19],["sand…",2.19,2.54],["made",2.91,3.06],["it!",3.06,3.16]],"voice":"myrobot"},{"i":8,"who":"spark","guestName":null,"text":"Same robot, different floors, different plan!","direction":null,"file":"/kids/audio/l1/L1-S15/8.ogg","dur":3.283,"env":"03qyuwoxuvvttsuuso8ktsi32000000mxz779umc75a8myzzvxqongqd300000000000ctzj77erof4382pmmmmnnnje2000000","words":[["Same",0.07,0.43],["robot,",0.43,0.85],["different",0.85,1.54],["floors,",1.54,2.03],["different",2.03,2.71],["plan!",2.71,3.07]],"voice":"spark"}]},{"setting":"The far side of the beach: the lift bridge over the harbour channel, raised high. A ship’s horn sounds.","action":"Across the bridge, at the foot of the lighthouse, something glows.","seconds":25,"lines":[{"i":9,"who":"amara","guestName":null,"text":"The eighth light is across the bridge — but the bridge is up!","direction":null,"file":"/kids/audio/l1/L1-S15/9.ogg","dur":3.471,"env":"000000004qvtxyxs80mzwruu9jruupmwk6iezxuehli007utn4hyvwoonicje200gtoehwl0myzvunpjotomssvrl500000000000000","words":[["The",0.13,0.34],["eighth",0.34,0.68],["light",0.68,0.97],["is",0.97,1.13],["across",1.13,1.46],["the",1.46,1.67],["bridge",1.67,2.0],["—",2.0,2.07],["but",2.07,2.27],["the",2.27,2.48],["bridge",2.48,2.81],["is",2.81,2.97],["up!",2.97,3.13]],"voice":"amara"},{"i":10,"who":"bolt","guestName":null,"text":"Beep-woof?","direction":"Looks up at the raised bridge.","file":"/kids/audio/l1/L1-S15/10.ogg","dur":1.58,"env":"0rtvr8ovvh000000002nzzzzpa8656543000000000000000","words":[["Beep",0.06,0.33],["woof?",0.41,1.34]],"voice":"bolt"}]}],"cliffhanger":{"text":"The eighth light is across the harbour bridge — and the bridge keeps going up and down for ships. When is it safe to cross?","file":"/kids/audio/l1/L1-S15/next.ogg","dur":8.132,"env":"000qxri28jne0h900mlzzzvzxvusvtg222000000000004wnepvxu9075uwwtm4mmdp57iwwqigf6nnffzzzu5hm22kusrssk209ed40000000qw74t9cyzt6aj38cqqa0cgg9vwtqtywusk60atuo9b0tzwstqre5inlppospl8007ed500000000003xzzzzzzzzzilmqq80