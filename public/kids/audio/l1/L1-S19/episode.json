{"sessionId":"L1-S19","number":19,"sessionTitle":"Feel Your Way","title":"Lost in the Fog","titleCard":{"text":"Episode 19. Lost in the Fog.","file":"/kids/audio/l1/L1-S19/title.ogg","dur":3.01,"env":"000lya0bqkrqkzzzt4hgmvyuuusuleksvwuwvvvtm80000000000auxqekmk772jrssssh456jzyxxwrb0600000000","words":[["Episode",0.1,1.01],["19.",1.01,1.39],["Lost",1.75,2.06],["in",2.06,2.25],["the",2.25,2.51],["Fog.",2.51,2.76]],"voice":"narrator"},"previously":{"text":"They sheltered at Nana’s house. Nine lights found — but fog covered the whole hill…","file":"/kids/audio/l1/L1-S19/prev.ogg","dur":6.231,"env":"000qwzvtsidlh20gb00jouvtutsttrtrnd00000000000xyiotrtzyzyc9jn8sqbgyvxvwwuwwsfhegjqppqrtsqfjgda0000000000000mwwssttuvvutswtsqlg02ekb3dwqqqrqromf2203zzwj2a009cry92y97400snhdmzzzzwm2000000000","words":[["Last",0.1,0.61],["time...",0.61,1.13],["They",1.49,1.76],["sheltered",1.76,2.28],["at",2.28,2.46],["Nana’s",2.46,2.78],["house.",2.78,3.1],["Nine",3.54,3.79],["lights",3.79,4.12],["found",4.12,4.4],["—",4.4,4.47],["but",4.47,4.67],["fog",4.67,4.87],["covered",4.87,5.24],["the",5.24,5.44],["whole",5.44,5.73],["hill…",5.73,5.97]],"voice":"narrator"},"scenes":[{"setting":"Morning at Nana Lucía’s house at the top of the hill. Thick white fog outside every window.","action":"Amara opens the door: she can barely see her own hand. Spark switches on the robot’s headlight — the beam just makes the fog glow white.","seconds":35,"lines":[{"i":0,"who":"amara","guestName":null,"text":"I can’t see anything! Not the clock, not the garden.","direction":null,"file":"/kids/audio/l1/L1-S19/0.ogg","dur":4.051,"env":"0000000arsdifwzysonfjhtutrnuszzyo2bqpmjgipi700000000000000000000kzzzzp35ne4b9vuzc0c92uytp343shfqtsnmppnlpwtg20000000000000","words":[["I",0.07,0.25],["can’t",0.25,0.65],["see",0.65,0.97],["anything!",0.97,1.65],["Not",1.97,2.21],["the",2.21,2.45],["clock,",2.45,2.8],["not",2.8,3.04],["the",3.04,3.28],["garden.",3.28,3.68]],"voice":"amara"},{"i":1,"who":"spark","guestName":null,"text":"The light bounces off the fog, right back at us. Seeing is no help today.","direction":null,"file":"/kids/audio/l1/L1-S19/1.ogg","dur":5.082,"env":"04vrphwztskc3000lqjih62ilcmijhlonne4562j5022mqnnnlkk72300004ksrspg3200jtromi44omgaqog5ajhhg500000008szufwwvtqpqkifmsoosgrvuqfcbzyh45fjlj87yvrrpl940000000","words":[["The",0.06,0.32],["light",0.32,0.7],["bounces",0.7,1.19],["off",1.19,1.45],["the",1.45,1.71],["fog,",1.71,1.96],["right",1.96,2.34],["back",2.34,2.66],["at",2.66,2.86],["us.",2.86,3.06],["Seeing",3.33,3.76],["is",3.76,3.97],["no",3.97,4.17],["help",4.17,4.49],["today.",4.49,4.86]],"voice":"spark"}]},{"setting":"Inside. Nana Lucía closes her eyes and walks across the room with one hand out, touching the wall.","action":"She reaches the door frame by touch. The children copy her, giggling, hands out.","seconds":35,"lines":[{"i":2,"who":"lucia","guestName":null,"text":"When I can’t see, I feel my way. My hand tells me: wall!","direction":null,"file":"/kids/audio/l1/L1-S19/2.ogg","dur":5.15,"env":"006iutotpe0gafsvsn90oxvxpjssqgnnkihe600000000emndda8frzvurtstrrsrgdrrqqqnnmmkie40000000000000boqrtrnghiqvqromhol7fhjnuususlqvmitustpghtsrrqpppmnlmje2000000","words":[["When",0.1,0.51],["I",0.51,0.7],["can’t",0.7,1.11],["see,",1.11,1.44],["I",1.44,1.63],["feel",1.63,2.04],["my",2.04,2.3],["way.",2.3,2.63],["My",3.13,3.38],["hand",3.38,3.79],["tells",3.79,4.27],["me:",4.27,4.53],["wall!",4.53,4.93]],"voice":"lucia"},{"i":3,"who":"lucia","guestName":null,"text":"Your robot can feel too — with a bumper.","direction":null,"file":"/kids/audio/l1/L1-S19/3.ogg","dur":3.211,"env":"006pvzwlhjpyzzxzzb2spnom5ib0fdhurc798cgzyzyu90nttmbvxxvusrqli400000000ucap6pxuqpqi0anonnkb0000000","words":[["Your",0.1,0.47],["robot",0.47,0.9],["can",0.9,1.2],["feel",1.2,1.57],["too",1.57,1.86],["—",1.86,1.96],["with",1.96,2.33],["a",2.33,2.5],["bumper.",2.5,2.99]],"voice":"lucia"}]},{"setting":"Close-up of the robot. A soft foam strip clicks onto its front. Inside, a tiny switch.","action":"Spark presses the foam with one finger: “click!” A little light flashes on the robot.","seconds":35,"lines":[{"i":4,"who":"spark","guestName":null,"text":"Touch the bumper… click! Now your robot knows: I touched something!","direction":null,"file":"/kids/audio/l1/L1-S19/4.ogg","dur":4.701,"env":"06lzo4hcco54wvsb535ijia62000000026ezwvtsk300453000000009iurqrpnnmlrzzpauxxxq65uqc324firpmkjhh9mh9000000003qtn96gkvr6cmi39qgnrkic22gg643000000","words":[["Touch",0.06,0.33],["the",0.33,0.51],["bumper…",0.51,0.81],["click!",1.11,1.55],["Now",1.87,2.13],["your",2.13,2.45],["robot",2.45,2.84],["knows:",2.84,3.22],["I",3.22,3.37],["touched",3.37,3.87],["something!",3.87,4.48]],"voice":"spark"},{"i":5,"who":"spark","guestName":null,"text":"That is a sensor. A sensor helps a robot feel or see the world.","direction":null,"file":"/kids/audio/l1/L1-S19/5.ogg","dur":4.391,"env":"04quvtyq8973dupogksioqpmmmiedboakfb200000003tkyuqqzvcmgoskdnvod6drlqa7jzyxxdpwssf4a654jpprnnok720jvxuikonsgqoo8ylcftvrpplld222000000","words":[["That",0.07,0.39],["is",0.39,0.6],["a",0.6,0.74],["sensor.",0.74,1.18],["A",1.47,1.6],["sensor",1.6,2.01],["helps",2.01,2.36],["a",2.36,2.5],["robot",2.5,2.85],["feel",2.85,3.15],["or",3.15,3.34],["see",3.34,3.59],["the",3.59,3.83],["world.",3.83,4.19]],"voice":"spark"}]},{"setting":"The foggy garden path. The garden wall is somewhere ahead — nobody knows how far.","action":"Amara counts hops: “three hops!” The robot stops in the middle of nowhere. She tries five: it bumps hard. Spark shakes his head.","seconds":45,"lines":[{"i":6,"who":"amara","guestName":null,"text":"I don’t know how far the wall is. How many hops?","direction":null,"file":"/kids/audio/l1/L1-S19/6.ogg","dur":3.85,"env":"00000005uuuszyparyxxtmqtp93qvqqlntsttsurnnmmolkbkkg2000000000000000000038jzztzxszzxvtkpzzzvh00002cljg700000000000000","words":[["I",0.27,0.37],["don’t",0.37,0.6],["know",0.6,0.83],["how",0.83,1.02],["far",1.02,1.21],["the",1.21,1.4],["wall",1.4,1.63],["is.",1.63,1.77],["How",2.4,2.69],["many",2.69,3.05],["hops?",3.05,3.41]],"voice":"amara"},{"i":7,"who":"spark","guestName":null,"text":"You don’t need to know! Tell your robot: keep going until you feel a bump.","direction":null,"file":"/kids/audio/l1/L1-S19/7.ogg","dur":4.757,"env":"00guxl6hzztsqnc39nnqtommb30chjppqzzwzzzzwqg400000000emzuwjszyrgowrro75murpb4250027qwvf4430mzwqmnmkjhh92kejbprpnhqh6565tsuzvrzy87pqna87200000000","words":[["You",0.08,0.33],["don’t",0.33,0.64],["need",0.64,0.95],["to",0.95,1.14],["know!",1.14,1.45],["Tell",1.75,2.03],["your",2.03,2.32],["robot:",2.32,2.66],["keep",2.66,2.94],["going",2.94,3.28],["until",3.28,3.62],["you",3.62,3.85],["feel",3.85,4.14],["a",4.14,4.27],["bump.",4.27,4.56]],"voice":"spark"},{"i":8,"who":"myrobot","guestName":null,"text":"Going… going… click! Found the wall!","direction":null,"file":"/kids/audio/l1/L1-S19/8.ogg","dur":2.949,"env":"003muusqkjjdb50000000000jtuurnkjfb4000000000003pztf20000000000atwnfhgni66ktrvrkf950000000","words":[["Going…",0.1,0.45],["going…",0.81,1.16],["click!",1.53,1.71],["Found",2.1,2.35],["the",2.35,2.53],["wall!",2.53,2.74]],"voice":"myrobot"}]},{"setting":"Along the garden wall to the gate.","action":"The robot feels its way: forward to the wall, a little back, turn, forward to the corner. In the corner, half hidden in the ivy, something glows warm and yellow.","seconds":40,"lines":[{"i":9,"who":"amara","guestName":null,"text":"Light number ten! It was in the ivy by the gate!","direction":null,"file":"/kids/audio/l1/L1-S19/9.ogg","dur":3.625,"env":"00000000vzzs9rzzyzztuyiakisqpmqzytd00000000000000000007nb8quoktzwzxqoszzxpowun6vrnrfrk29rsokh70bd400000000000","words":[["Light",0.07,0.48],["number",0.48,0.94],["ten!",0.94,1.22],["It",1.83,1.98],["was",1.98,2.17],["in",2.17,2.32],["the",2.32,2.51],["ivy",2.51,2.7],["by",2.7,2.85],["the",2.85,3.03],["gate!",3.03,3.27]],"voice":"amara"},{"i":10,"who":"bolt","guestName":null,"text":"Woof!","direction":"Bolt runs off into the fog, chasing a sound.","file":"/kids/audio/l1/L1-S19/10.ogg