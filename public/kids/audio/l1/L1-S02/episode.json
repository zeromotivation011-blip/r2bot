ares. Let’s count them. One, two, three!","direction":null,"file":"/kids/audio/l1/L1-S02/8.ogg","dur":5.33,"env":"00000000myzx87402rm5afyzvyk02cwvpprg2lvuwqrqnmmhii930000000000000000000iuwr48or8fxzuvqondqpltumg2000000000000000000000002yzwwzokrfwxxyyuh7kzzxvuuwrd000000000000","words":[["Look",0.17,0.47],["—",0.47,0.56],["the",0.56,0.81],["path",0.81,1.12],["has",1.12,1.37],["squares.",1.37,1.85],["Let’s",2.19,2.61],["count",2.61,3.09],["them.",3.09,3.51],["One,",3.88,4.25],["two,",4.25,4.62],["three!",4.62,5.16]],"voice":"amara"},{"i":9,"who":"spark","guestName":null,"text":"How many squares to the light? Count with me!","direction":"Pause for the children to count.","file":"/kids/audio/l1/L1-S02/9.ogg","dur":2.966,"env":"00esrsnkoupkmljdrve33rvywurnern3forbotpqsqkljh9300b8000000005ntomld658ssa43diklljf7000000","words":[["How",0.08,0.3],["many",0.3,0.58],["squares",0.58,1.0],["to",1.0,1.18],["the",1.18,1.4],["light?",1.4,1.72],["Count",2.0,2.32],["with",2.32,2.59],["me!",2.59,2.76]],"voice":"spark"}]},{"setting":"Garden path. A golden clock light glows beside a flowerpot.","action":"The robot hops exactly to the light and stops. The light jumps happily onto the robot’s back. Counter on screen: 1 of 12.","seconds":30,"lines":[{"i":10,"who":"spark","guestName":null,"text":"You found the first light! One!","direction":null,"file":"/kids/audio/l1/L1-S02/10.ogg","dur":2.33,"env":"00qvua555vzpqpjfga9j344wum9foe7dlornold6200cd00000000itvsoljeea3000000","words":[["You",0.08,0.31],["found",0.31,0.63],["the",0.63,0.86],["first",0.86,1.19],["light!",1.19,1.51],["One!",1.79,2.12]],"voice":"spark"},{"i":11,"who":"lucia","guestName":null,"text":"Good counting makes good robots.","direction":null,"file":"/kids/audio/l1/L1-S02/11.ogg","dur":2.55,"env":"007vzx700ijjixvvqsksdqstuuutr0aqvvsh00fzzwbdtuxzxwm6cqpmml8000jtvtsnoi4000000","words":[["Good",0.1,0.46],["counting",0.46,1.07],["makes",1.07,1.49],["good",1.49,1.85],["robots.",1.85,2.34]],"voice":"lucia"}]},{"setting":"The light on