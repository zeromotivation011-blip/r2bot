{"sessionId":"L1-S22","number":22,"sessionTitle":"Stop for Friends","title":"The Busy Square","titleCard":{"text":"Episode 22. The Busy Square.","file":"/kids/audio/l1/L1-S22/title.ogg","dur":2.996,"env":"000foc0nolmgxsj5f4kqwrthdjt60iauttpnj60000000000000zf20zzwcjryvmmon48ozxvusuvutppk60000000","words":[["Episode",0.11,0.91],["22.",0.91,1.24],["The",1.69,1.97],["Busy",1.97,2.3],["Square.",2.3,2.76]],"voice":"narrator"},"previously":{"text":"Distance Eyes found light eleven by its echo. The square filled with people for the festival…","file":"/kids/audio/l1/L1-S22/prev.ogg","dur":7.173,"env":"000sxzzxtqnbjki30005heutrrqqrpqpma00000000004uzlrheetsmemkd0vvstuutshpb04xqprstsqlc9lwxwuusp80ioxwzzzj5mxvwnptturoj26lc3awi48bitprqpk40000000000cwhmi36xzzzsf755jzxxxxk82sq400ayys208uqi3pfvc36zvgpnmc4qhfrrom800000000","words":[["Last",0.1,0.61],["time...",0.61,1.11],["Distance",1.49,2.06],["Eyes",2.06,2.39],["found",2.39,2.79],["light",2.79,3.18],["eleven",3.18,3.63],["by",3.63,3.84],["its",3.84,4.11],["echo.",4.11,4.44],["The",4.82,5.0],["square",5.0,5.3],["filled",5.3,5.6],["with",5.6,5.83],["people",5.83,6.13],["for",6.13,6.31],["the",6.31,6.49],["festival…",6.49,6.87]],"voice":"narrator"},"scenes":[{"setting":"The town square on festival day. The fog is lifting. Stalls, garlands, a juggler, children running.","action":"The robot has to carry the eleventh light to the clock tower door across the square. People cross in front of it again and again.","seconds":35,"lines":[{"i":0,"who":"amara","guestName":null,"text":"There are people everywhere! How do we get across?","direction":null,"file":"/kids/audio/l1/L1-S22/0.ogg","dur":3.693,"env":"000000002rzzzwc4hzxe3xyuihytlqvutrtvwwulji82000000000000000000004itzzwtgmpqttrfurjo734eoomnlg89acid852000000000","words":[["There",0.06,0.38],["are",0.38,0.6],["people",0.6,0.97],["everywhere!",0.97,1.53],["How",2.14,2.38],["do",2.38,2.56],["we",2.56,2.75],["get",2.75,2.99],["across?",2.99,3.38]],"voice":"amara"},{"i":1,"who":"spark","guestName":null,"text":"A good robot never rushes through people. It waits.","direction":null,"file":"/kids/audio/l1/L1-S22/1.ogg","dur":3.661,"env":"00lza96fzzodbozrtsd5qkc25lsrrfcphaapssl9dfcniajj40000000002ovvm446tsrc30ic300000005zw943yzvwpj503tzknd30000000","words":[["A",0.08,0.22],["good",0.22,0.52],["robot",0.52,0.87],["never",0.87,1.22],["rushes",1.22,1.62],["through",1.62,2.08],["people.",2.08,2.49],["It",2.78,3.0],["waits.",3.0,3.43]],"voice":"spark"}]},{"setting":"A zebra crossing at the edge of the square. Noor, the little girl from the bakery street, holds her father’s hand.","action":"They stop, look, wait for a cart to pass, then cross. Spark copies them.","seconds":40,"lines":[{"i":2,"who":"guest","guestName":"Noor, age 5","text":"We stop. We look. We wait. Then we go!","direction":null,"file":"/kids/audio/l1/L1-S22/2.ogg","dur":4.616,"env":"000000000mztfc4pztg730000000000000000000000000jyzzzzt3096200000000000000000000ozzzzzzxum3b42000000000000000000qzuzzxq9zzzwuui50000000000000","words":[["We",0.1,0.36],["stop.",0.36,0.78],["We",1.49,1.71],["look.",1.71,2.05],["We",2.38,2.75],["wait.",2.75,3.33],["Then",3.68,3.91],["we",3.91,4.05],["go!",4.05,4.2]],"voice":"noor"},{"i":3,"who":"spark","guestName":null,"text":"Your robot can do that too. Before each hop: wait until the path is clear.","direction":null,"file":"/kids/audio/l1/L1-S22/3.ogg","dur":5.282,"env":"00rxzuqijzysuo7kttq760aislma3lyzxupizum452ljlyxslie8300000004td75tzwq453luurh4apgaarpjf54400000000000tywrhd7200bool9dqrbjv909ivlmk5530knxs53472sxwqxri750000000","words":[["Your",0.08,0.39],["robot",0.39,0.75],["can",0.75,1.0],["do",1.0,1.19],["that",1.19,1.49],["too.",1.49,1.74],["Before",2.03,2.49],["each",2.49,2.83],["hop:",2.83,3.1],["wait",3.1,3.44],["until",3.44,3.83],["the",3.83,4.11],["path",4.11,4.44],["is",4.44,4.66],["clear.",4.66,5.05]],"voice":"spark"}]},{"setting":"Robot’s-eye view: the distance number above the robot.","action":"A juggler steps in front: the number drops to 30 and the robot waits. He steps away: the number jumps to 150, and the robot hops.","seconds":40,"lines":[{"i":4,"who":"myrobot","guestName":null,"text":"Path not clear. Waiting… Clear! Hop!","direction":null,"file":"/kids/audio/l1/L1-S22/4.ogg","dur":3.058,"env":"000blpp7032eqqc0033igmhbd30000000000dwztbijhc4000000000047uwzutsf300000000000cpvsp6000000000","words":[["Path",0.11,0.36],["not",0.36,0.56],["clear.",0.56,0.85],["Waiting…",1.22,1.52],["Clear!",1.89,2.2],["Hop!",2.57,2.85]],"voice":"myrobot"},{"i":5,"who":"guest","guestName":"Noor, age 5","text":"It waited for the juggler! Good robot!","direction":null,"file":"/kids/audio/l1/L1-S22/5.ogg","dur":2.986,"env":"00000000gxxqjuzzflsm835jlnp7hwynbppmig500000000000000000000004wzcgwzzzifvrplb0000000000000","words":[["It",0.3,0.42],["waited",0.42,0.7],["for",0.7,0.86],["the",0.86,1.03],["juggler!",1.03,1.34],["Good",2.07,2.35],["robot!",2.35,2.68]],"voice":"noor"}]},{"setting":"Nana Lucía sits on a bench with the children.","action":"She shows an old photo: young Lucía in a workshop with a big robot arm behind a yellow safety fence.","seconds":45,"lines":[{"i":6,"who":"lucia","guestName":null,"text":"When I built robots, the first question was always: how do we keep people safe?","direction":null,"file":"/kids/audio/l1/L1-S22/6.ogg","dur":5.412,"env":"00hstxtukg4szxwf0632gxzyyr9mrooni4007innla0000000000000jn8bcrxxvjms8f8466ttpmel63kesrropg20008wuwtprzwlhrgbxuwgsyuvvd0bfd8twn20d7qn20isqjmopjcpurspoic2200022000000","words":[["When",0.1,0.43],["I",0.43,0.58],["built",0.58,0.98],["robots,",0.98,1.43],["the",1.43,1.7],["first",1.7,2.09],["question",2.09,2.67],["was",2.67,2.94],["always:",2.94,3.39],["how",3.39,3.66],["do",3.66,3.87],["we",3.87,4.09],["keep",4.09,4.42],["people",4.42,4.87],["safe?",4.87,5.2]],"voice":"lucia"},{"i":7,"who":"amara","guestName":null,"text":"Who keeps a robot safe? The robot?","direction":null,"file":"/kids/audio/l1/L1-S22/7.ogg","dur":3.447,"env":"0000000035wxo7lvzzs9piwwuuzzzwszv93kontnmnm944433220000000000