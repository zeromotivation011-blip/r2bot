",1.66,2.15],["and",2.15,2.34],["pull",2.34,2.58],["the",2.58,2.77],["other!",2.77,3.04]],"voice":"spark"}]},{"setting":"The square. The robot faces the camera; Amara stands behind it.","action":"Amara holds up her right hand. The robot turns — to ITS right, which looks like left to us. Bolt tilts his head.","seconds":45,"lines":[{"i":5,"who":"amara","guestName":null,"text":"Turn right! Wait… it went the other way?","direction":null,"file":"/kids/audio/l1/L1-S05/5.ogg","dur":3.782,"env":"0000007hdxxywyyzwyumjjh20200200000000300000czzzyoa200020000000000000000gvqzyvui00uyzzztrzzqyvwvqmk8000000000000000","words":[["Turn",0.12,0.53],["right!",0.53,1.01],["Wait…",1.24,1.94],["it",2.26,2.45],["went",2.45,2.76],["the",2.76,3.01],["other",3.01,3.37],["way?",3.37,3.62]],"voice":"amara"},{"i":6,"who":"lucia","guestName":null,"text":"It turned to ITS right. Pretend you are sitting inside the robot.","direction":null,"file":"/kids/audio/l1/L1-S05/6.ogg","dur":4.328,"env":"002oi00uk6psronnf43or80svi4ostrromkd00ok70000000000000037v60qh6gpzwsuvtjpkyuqjputsulnbsvruusqjtwkfxtvq78togtzvxo2fsmnka207k8000000","words":[["It",0.11,0.28],["turned",0.28,0.65],["to",0.65,0.82],["ITS",0.82,1.04],["right.",1.04,1.36],["Pretend",1.86,2.29],["you",2.29,2.52],["are",2.52,2.75],["sitting",2.75,3.18],["inside",3.18,3.56],["the",3.56,3.79],["robot.",3.79,4.12]],"voice":"lucia"},{"i":7,"who":"spark","guestName":null,"text":"Stand up and turn like your robot. Turn right! Now turn left!","direction":"Pause for children to stand and turn.","file":"/kids/audio/l1/L1-S05/7.ogg","dur":4.478,"env":"02tmdwxuwwrxsqzzta5humphbgfojklmnrroh44brxscrysoe43slc32a600000000j9srrrmmjiotrrmid400fi8000000000cisqpmie30m8trmstqqwvqma5560cd0000000","words":[["Stand",0.07,0.39],["up",0.39,0.57],["and",0.57,0.79],["turn",0.79,1.06],["like",1.06,1.33],["your",1.33,1.61],["robot.",1.61,1.93],["Turn",2.22,2.56],["right!",2.56,2.97],["Now",3.28,3.56],["turn",3.56,3.92],["left!",3.92,4.27]],"voice":"spark"}]},{"setting":"The square, seen from above. Squares drawn on the stones; the fountain in the middle.","action":"The robot goes up, turns right, goes along the top. A sparkle near the fountain wall: the light! It jumps up — and lands IN the fountain bowl.","seconds":35,"lines":[{"i":8,"who":"myrobot","guestName":null,"text":"Turning right!","direction":null,"file":"/kids/audio/l1/L1-S05/8.ogg","dur":0.835,"env":"0004jppimnkjfiqomf5000000","words":[["Turning",0.1,0.4],["right!",0.4,0.62]],"voice":"myrobot"},{"i":9,"who":"spark","guestName":null,"text":"There it is! Oh no, it jumped into the fountain!","direction":null,"file":"/kids/audio/l1/L1-S05/9.ogg","dur":3.403,"env":"004zzzusuwq5393phid6lnmc200000000azztsroqvysqsvuusi9kia05otxpjh54a202oomcil5l653kmihifc3ecnj9c97000000","words":[["There",0.1,0.45],["it",0.45,0.64],["is!",0.64,0.83],["Oh",1.13,1.32],["no,",1.32,1.51],["it",1.51,1.71],["jumped",1.71,2.12],["into",2.12,2.43],["the",2.43,2.67],["fountain!",2.67,3.2]],"voice":"spark"}]},{"setting":"The fountain. Townspeople gather, looking sad: the festival decorations are not ready.","action":"The light glows at the bottom of the fountain bowl, out of reach. Nana Lucía has an idea and smiles.","seconds":25,"lines":[{"i":10,"who":"lucia","guestName":null,"text":"Everyone looks sad. A happy dance might shake the fountain — and cheer up the town.","direction":null,"file":"/kids/audio/l1/L1-S05/10.ogg","dur":6.455,"env":"00dwwypkjnozzzxxhiwusuuvuzr0fqxzwygrtstrqpqoqj79g900000000000000bfigkvwuh0asrf0bosomlmmlhwtt6epppj05noqpcvtc008scgecwupppomkek4glmiihf930000000000000erpdqpppmmuqsrj003gjio5brponppnonnklgb4000000","words":[["Everyone",0.1,0.82],["looks",0.82,1.31],["sad.",1.31,1.65],["A",2.15,2.3],["happy",2.3,2.68],["dance",2.68,3.07],["might",3.07,3.46],["shake",3.46,3.85],["the",3.85,4.12],["fountain",4.12,4.69],["—",4.69,4.77],["and",4.77,5.04],["cheer",5.04,5.43],["up",5.43,5.64],["the",5.64,5.91],["town.",5.91,6.24]],"voice":"lucia"},{"i":11,"who":"amara","guestName":null,"text":"A robot