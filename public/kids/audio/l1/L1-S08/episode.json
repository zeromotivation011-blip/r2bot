/8.ogg","dur":2.903,"env":"027zxmnokjljaft620sppqo85300000003newrkqnsnje22rxzlki32byrun57fqnlhmh295jwuoole53000000","words":[["Found",0.07,0.4],["the",0.4,0.62],["bug!",0.62,0.85],["Change",1.14,1.55],["just",1.55,1.85],["that",1.85,2.15],["one",2.15,2.4],["card.",2.4,2.7]],"voice":"spark"},{"i":9,"who":"spark","guestName":null,"text":"Did you see it too? Point when the robot goes wrong!","direction":"Pause.","file":"/kids/audio/l1/L1-S08/9.ogg","dur":3.584,"env":"00hwzwscanmwvhxswwksqqdzs430lkaxzzvsoroh3000000005qzzopoka60lrfmpkbjzvyo7qrmj842fxsooinabaqqmmlmefca70000000","words":[["Did",0.1,0.36],["you",0.36,0.63],["see",0.63,0.89],["it",0.89,1.09],["too?",1.09,1.36],["Point",1.63,1.95],["when",1.95,2.23],["the",2.23,2.45],["robot",2.45,2.77],["goes",2.77,3.04],["wrong!",3.04,3.36]],"voice":"spark"}]},{"setting":"The flower stall: buckets of sunflowers, marigolds and roses.","action":"Fixed program. The robot rolls to the flowers and stops. The fourth light rises from a bucket of marigolds. Counter: 4 of 12.","seconds":30,"lines":[{"i":10,"who":"myrobot","guestName":null,"text":"Found a light!","direction":null,"file":"/kids/audio/l1/L1-S08/10.ogg","dur":0.807,"env":"000etqmgjkmhiqqkg60000000","words":[["Found",0.12,0.33],["a",0.33,0.4],["light!",0.4,0.61]],"voice":"myrobot"},{"i":11,"who":"guest","guestName":"Mr Diego, the flower seller","text":"So THAT’S why my marigolds were glowing!","direction":null,"file":"/kids/audio/l1/L1-S08/11.ogg","dur":2.673,"env":"000000000443wpgcsl5764ptsojnoolppqooonh638qpnnlb65drpa07nttsrmie9000000000000000","words":[["So",0.1,0.29],["THAT’S",0.29,0.65],["why",0.65,0.9],["my",0.9,1.09],["marigolds",1.09,1.67],["were",1.67,1.97],["glowing!",1.97,2.44]],"voice":"diego"}]},{"setting":"A puddle by the fountain. Bolt splashes in it with the map.","action":"The map is soaked. The ink of the path to the school runs and fades away.","seconds":20,"lines":[{"i":12,"who":"amara","guestName":null,"text":"Bolt! The path to the school is all wash