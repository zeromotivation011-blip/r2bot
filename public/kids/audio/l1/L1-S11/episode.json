p blank festival banner.","seconds":30,"lines":[{"i":8,"who":"guest","guestName":"Mr Haruto, the librarian","text":"Thank you! Now — the festival banner is still empty. Could your robot help?","direction":null,"file":"/kids/audio/l1/L1-S11/8.ogg","dur":6.071,"env":"0006hullj6cachidda600000000004emigedddfcfc930000000000000000op9bgorkhmnmedh76nnmmkb60liggdeiljhjkhloollh3kngh5cnjjib006gec87430000000000bntd708qtrusvpihjqob3loffb0027gkhge90030000000","words":[["Thank",0.11,0.41],["you!",0.41,0.62],["Now",0.99,1.32],["—",1.32,1.43],["the",1.43,1.75],["festival",1.75,2.44],["banner",2.44,2.98],["is",2.98,3.24],["still",3.24,3.71],["empty.",3.71,4.18],["Could",4.55,4.89],["your",4.89,5.18],["robot",5.18,5.53],["help?",5.53,5.82]],"voice":"haruto"},{"i":9,"who":"myrobot","guestName":null,"text":"I can draw!","direction":null,"file":"/kids/audio/l1/L1-S11/9.ogg","dur":0.991,"env":"002hpc24hkmi3brpsttulc50000000","words":[["I",0.1,0.23],["can",0.23,0.48],["draw!",0.48,0.77]],"voice":"myrobot"}]},{"setting":"Amara unrolls the banner a little. Something inside glows faintly.","action":"She rolls it back up quickly to keep the surprise.","seconds":20,"lines":[{"i":10,"who":"amara","guestName":null,"text":"Something is glowing inside the banner!","direction":null,"file":"/kids/audio/l1/L1-S11/10.ogg","dur":2.402,"env":"00000000bknvxwyonyzzxsmg3pzwwwzzzvzwljyxuyqj7urhztrmkleihd00000000000000","words":[["Something",0.16,0.66],["is",0.66,0.83],["glowing",0.83,1.24],["inside",1.24,1.6],["the",1.6,1.82],["banner!",1.82,2.18]],"voice":"amara"},{"i":11,"who":"spark","guestName":null,"text":"We will find out — when we draw on it!","direction":null,"file":"/kids/audio/l1/L1-S11/11.ogg","dur":3.062,"env":"00rxyyyuhhzzr6752hqlknmkhha2b4ptrttrd54g4000000000000pvmnnpvrh7guwqoqqg8imnllnnme40af0000000","words":[["We",0.08,0.31],["will",0.31,0.67],["find",0.67,1.03],["out",1.03,1.33],["—",1.33,1.43],["when",1.43,1.79],["we",1.79,2.02],["draw",2.02,2.38],["on",2.38,2.61],["it!",2.61,2.84]],"voice"